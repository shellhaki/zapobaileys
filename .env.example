# HTTP port
PORT=3000

# sqlite://path or a postgres:// URL
DATABASE_URL=sqlite://data/sessions.db

SESSION_PREFIX=shell

# Name shown under Linked devices
DEVICE_NAME=Chrome (Linux)

# Also send the session ID to the user's own WhatsApp chat
SEND_TO_DM=true

# Pairings running at once, and per IP per hour
MAX_ACTIVE_PAIRINGS=50
PAIRINGS_PER_HOUR=10
PAIR_TIMEOUT_SECONDS=180

# Delete sessions not fetched for this many days
SESSION_TTL_DAYS=90

# Set true behind a reverse proxy so rate limits see real IPs
TRUST_PROXY=false

# Print zapo connection logs
# PAIR_DEBUG=1
